---
const products = [
  { name: "DisTube", href: "/distube/", line: "Play music in Discord voice channels with discord.js, Eris or Oceanic." },
  { name: "DisTube Plugins", href: "/distube/plugins/", line: "Official YouTube, SoundCloud, Spotify and Lavalink sources." },
  { name: "ytdl-core", href: "/ytdl-core/", line: "Read YouTube video info and stream any format from Node.js." },
];
---

<section class="yt-hero" aria-labelledby="_top">
  <div class="yt-hero-copy">
    <h1 id="_top" data-page-title>
      <span class="yt-line"><span>Music bots</span></span>
      <span class="yt-line"><span>for Discord</span></span>
    </h1>
    <p class="yt-hero-lead">Guides and API reference for DisTube, its official plugins and ytdl-core.</p>
    <div class="yt-hero-actions">
      <a class="yt-button" href="/distube/">Read the DisTube docs</a>
      <a class="yt-link" href="https://github.com/skick1234/DisTube">GitHub</a>
    </div>
    <div class="yt-hero-install">
      <pre><code>bun add distube @distube/discordjs</code></pre>
    </div>
  </div>

  <div class="yt-hero-stage">
    <ol class="yt-products" aria-label="Products">
      {
        products.map((product) => (
          <li>
            <a href={product.href}>
              <strong>{product.name}</strong>
              <span>{product.line}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .yt-hero {
    display: grid;
    grid-template-columns: 7fr 5fr;
    grid-template-rows: minmax(0, 1fr);
    height: max(42rem, calc(100svh - var(--sl-nav-height)));
    background: var(--yt-bg);
  }

  .yt-hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--yt-margin);
    gap: 2rem;
  }

  .yt-hero-install {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    animation: yt-fade 700ms 500ms var(--yt-ease) both;
  }

  .yt-hero-install pre {
    margin: 0;
    padding: 0.875rem 1.25rem;
    border-radius: 8px;
    background: var(--yt-surface);
    font-size: 1rem;
  }

  .yt-hero h1 {
    font-size: var(--step-display);
  }

  .yt-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .yt-line > span {
    display: block;
    animation: yt-line 900ms var(--yt-ease) both;
  }

  .yt-line + .yt-line > span {
    animation-delay: 110ms;
  }

  @keyframes yt-line {
    from {
      transform: translateY(105%);
    }
  }

  .yt-hero-lead {
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: 34ch;
    animation: yt-fade 700ms 400ms var(--yt-ease) both;
  }

  .yt-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    white-space: nowrap;
    animation: yt-fade 700ms 400ms var(--yt-ease) both;
  }

  @keyframes yt-fade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .yt-hero-stage {
    background: var(--yt-surface);
    display: grid;
    place-items: center end;
    padding: var(--yt-margin);
  }

  .yt-products {
    width: min(100%, 36rem);
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    animation: yt-fade 700ms 500ms var(--yt-ease) both;
  }

  .yt-products a {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem;
    border-radius: 12px;
    background: var(--yt-bg);
    color: var(--yt-ink);
    text-decoration: none;
    transition:
      background-color 160ms var(--yt-ease),
      transform 160ms var(--yt-ease);
  }

  .yt-products a:hover {
    background: var(--yt-accent);
    color: var(--yt-accent-ink);
  }

  .yt-products a:active {
    transform: scale(0.98);
  }

  .yt-products strong {
    font: 700 var(--step-lead) / 1.1 var(--yt-display);
    letter-spacing: -0.02em;
  }

  .yt-products span {
    color: inherit;
    opacity: 0.8;
    font-size: 1rem;
  }

  @media (max-width: 50rem) {
    .yt-hero {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      height: auto;
    }

    .yt-products {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .yt-line > span,
    .yt-hero-lead,
    .yt-hero-actions,
    .yt-hero-install,
    .yt-products {
      animation: none;
    }
  }
</style>
