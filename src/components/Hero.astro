---
import { servedPages } from "../served.ts";
import FormatPicker from "./FormatPicker.astro";

const pages = await servedPages();
const hasDistube = pages.has("/distube/");
const hasYtdl = pages.has("/ytdl-core/");
const distube = [
  { name: "Quick start", href: "/distube/get-started/quick-start/", line: "Play, skip and stop music with one discord.js file." },
  { name: "Plugins", href: "/distube/plugins/", line: "Official YouTube, SoundCloud, Spotify and Lavalink sources." },
  { name: "API reference", href: "/distube/api/readme/", line: "Every class, event and integration contract." },
].filter((item) => pages.has(item.href));
const ytdlGuide = "/ytdl-core/guides/getting-started/";
const ytdlApi = "/ytdl-core/api/readme/";
const Heading = hasDistube ? "h2" : "h1";
const ytdlHeading = hasDistube ? "ytdl-core" : "_top";
---

{hasDistube && (
<section class="yt-hero" aria-labelledby="_top">
  <div class="yt-hero-copy">
    <h1 id="_top" data-page-title>
      <span class="yt-line"><span>Music bots</span></span>
      <span class="yt-line"><span>for Discord</span></span>
    </h1>
    <p class="yt-hero-lead">Queue, play and filter music in voice channels. Sources come from plugins.</p>
    <div class="yt-hero-actions">
      <a class="yt-button" href="/distube/">Read the DisTube docs</a>
      <a class="yt-link" href="https://github.com/skick1234/DisTube">GitHub</a>
    </div>
  </div>

  <div class="yt-hero-stage">
    <ol class="yt-products" aria-label="DisTube">
      {
        distube.map((item) => (
          <li>
            <a href={item.href}>
              <strong>{item.name}</strong>
              <span>{item.line}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
)}

{hasYtdl && (
<section class="yt-hero" aria-labelledby={ytdlHeading}>
  <div class="yt-hero-copy">
    <Heading id={ytdlHeading} data-page-title={hasDistube ? undefined : true}>
      <span class="yt-line"><span>YouTube downloads</span></span>
      <span class="yt-line"><span>for Node.js</span></span>
    </Heading>
    <p class="yt-hero-lead">
      Read a video's details and every format, then stream the one you want. Signatures are solved on your machine.
    </p>
    <div class="yt-hero-actions">
      {pages.has(ytdlGuide) && <a class="yt-button" href={ytdlGuide}>Download your first video</a>}
      {pages.has(ytdlApi) && <a class="yt-link" href={ytdlApi}>API reference</a>}
    </div>
  </div>

  <div class="yt-hero-stage">
    <FormatPicker />
  </div>
</section>
)}

<style>
  .yt-hero {
    display: grid;
    grid-template-columns: 7fr 5fr;
    grid-template-rows: minmax(0, 1fr);
    height: max(42rem, calc(100svh - var(--sl-nav-height)));
    background: var(--yt-bg);
  }

  .yt-hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--yt-margin);
    gap: 2rem;
  }



  .yt-hero h1,
  .yt-hero h2 {
    font-size: var(--step-display);
  }

  .yt-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .yt-line > span {
    display: block;
    animation: yt-line 900ms var(--yt-ease) both;
  }

  .yt-line + .yt-line > span {
    animation-delay: 110ms;
  }

  @keyframes yt-line {
    from {
      transform: translateY(105%);
    }
  }

  .yt-hero-lead {
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: 34ch;
    animation: yt-fade 700ms 400ms var(--yt-ease) both;
  }

  .yt-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    white-space: nowrap;
    animation: yt-fade 700ms 400ms var(--yt-ease) both;
  }

  @keyframes yt-fade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .yt-hero-stage {
    background: var(--yt-surface);
    display: grid;
    place-items: center stretch;
    padding: var(--yt-margin);
  }

  .yt-products {
    width: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    animation: yt-fade 700ms 500ms var(--yt-ease) both;
  }

  .yt-products a {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem;
    border-radius: 12px;
    background: var(--yt-bg);
    color: var(--yt-ink);
    text-decoration: none;
    transition:
      background-color 160ms var(--yt-ease),
      transform 160ms var(--yt-ease);
  }

  .yt-products a:hover {
    background: var(--yt-accent);
    color: var(--yt-accent-ink);
  }

  .yt-products a:active {
    transform: scale(0.98);
  }

  .yt-products strong {
    font: 700 var(--step-lead) / 1.1 var(--yt-display);
    letter-spacing: -0.02em;
  }

  .yt-products span {
    color: inherit;
    opacity: 0.8;
    font-size: 1rem;
  }

  @media (max-width: 50rem) {
    .yt-hero {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      height: auto;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .yt-line > span,
    .yt-hero-lead,
    .yt-hero-actions,
    .yt-products {
      animation: none;
    }
  }
</style>
