---
import Default from "@astrojs/starlight/components/Footer.astro";

const landing = Astro.locals.starlightRoute.entry.data.hero !== undefined;
---

<Default><slot /></Default>
{
  !landing && (
    <p class="site-footer">
      MIT licence. Built by Skick and contributors.
      <a href="https://github.com/skick1234/DisTube">DisTube</a>
      <a href="https://github.com/distubejs/ytdl-core">ytdl-core</a>
      <a href="https://www.npmjs.com/package/distube">npm</a>
      <a href="https://ko-fi.com/skick">Ko-fi</a>
    </p>
  )
}

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .site-footer a {
    color: inherit;
  }

  .site-footer a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
